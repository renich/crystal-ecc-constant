direction: right

vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 4
    pad: 40
  }
}

classes: {
  milestone_box: {
    style: {
      stroke: "#6B46C1"
      stroke-width: 2
      border-radius: 8
      fill: "#FAF5FF"
    }
  }
  planned_task: {
    shape: rectangle
    style: {
      stroke: "#6B46C1"
      stroke-width: 2
      border-radius: 6
      fill: "#F3E8FF"
      font-color: "#44337A"
      bold: true
    }
  }
}

m2_1: "Milestone 2.1: Ed25519ph Streaming Signatures" {
  class: milestone_box

  task201: "TASK-201: LibSodium Ed25519ph & KDF Bindings\nFulfills [FUNC-006] [FUNC-007]\nImplements [TECH-006] [TECH-007]" {
    class: planned_task
  }

  task202: "TASK-202: Guarded Ed25519ph Streaming State\nFulfills [FUNC-006]\nImplements [TECH-006]" {
    class: planned_task
  }

  task201 -> task202: "Unblocks"
}

m2_2: "Milestone 2.2: Guarded Subkey KDF & Wycheproof Vectors" {
  class: milestone_box

  task203: "TASK-203: Guarded crypto_kdf Subkey Derivation\nFulfills [FUNC-007]\nImplements [TECH-007]" {
    class: planned_task
  }

  task204: "TASK-204: RFC 8032, RFC 7748 & Wycheproof Suite\nFulfills [FUNC-006] [FUNC-007]\nImplements [TECH-005] [TECH-006] [TECH-007]" {
    class: planned_task
  }

  task203 -> task204: "Unblocks"
}

m2_1.task201 -> m2_2.task203: "Unblocks"
m2_1.task202 -> m2_2.task204: "Unblocks"
