root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cr]
indent_style = space
indent_size = 2

[*.rst]
indent_style = space
indent_size = 3

[*.py]
indent_style = space
indent_size = 4

[*.bash]
indent_style = space
indent_size = 2

[{GNUmakefile,Makefile,*.mk}]
indent_style = tab
indent_size = 8
